# uzu Home backend settings. uzu Home and uzuctl edit these; by hand, edit then `uzuctl engine restart`.

# Model key from models.conf
MODEL=qwen3.5-9b-m
# Prompt + reply window in tokens. Hermes refuses endpoints under 64,000 tokens.
CONTEXT=65536
# Conversations the engine keeps at once, each with its own context: a 9B Qwen3.5 with its speculator takes about 10 GB
# with one at 64K, 13 GB with two. With 2, a short side request (Hermes's chat titles) does not make the next turn of a
# long conversation read its whole prompt again. Requests run one at a time either way.
SESSIONS=1
# on|off: whether the model thinks when a request does not say (off is faster). Requests can still ask for it.
THINKING=off
# always = keep the model loaded; idle = unload after IDLE_MINUTES without requests; ondemand = load on the first
# request (nothing loads when the app opens) and unload when idle. The endpoint wakes an unloaded model on demand.
MEMORY_MODE=idle
IDLE_MINUTES=30

# Stable endpoint for Hermes and any OpenAI-compatible client: http://127.0.0.1:GATEWAY_PORT/v1
GATEWAY_PORT=8585
# Internal uzu server port (clients should use the endpoint)
ENGINE_PORT=18585
# Model id every client uses, whatever model is loaded
SERVED_NAME=uzu

# 1 = keep the endpoint running from login so Hermes can always reach it (it starts the engine on demand)
ENDPOINT_AT_LOGIN=1
# Serve the endpoint to other computers on the network (0.0.0.0). With REQUIRE_KEY=1 they must send the key in
# state/api_key (Authorization: Bearer <key> or x-api-key); requests from this Mac never need it.
SHARE_ON_NETWORK=0
REQUIRE_KEY=0

# Daily check for a new uzu engine (1 = on), and its time (24h clock, local)
AUTO_UPDATE=1
UPDATE_HOUR=4
UPDATE_MINUTE=45

# The Python that runs the endpoint (set up by install.sh)
PYTHON=/usr/bin/python3
