diff --git a/crates/legacy/cli/src/server/state.rs b/crates/legacy/cli/src/server/state.rs
index 302f9401..f148f3d8 100644
--- a/crates/legacy/cli/src/server/state.rs
+++ b/crates/legacy/cli/src/server/state.rs
@@ -1,3 +1,43 @@
+use std::{
+    sync::{Arc, Mutex as StdMutex},
+    time::Instant,
+};
+
+use tokio::sync::Mutex;
+use uzu::session::chat::ChatSession;
+
 pub struct ServerState {
     pub model_name: String,
 }
+
+/// Chat sessions over one loaded model, each with its own conversation state. Requests still run one at a time
+/// (`turn`); each goes to the session whose conversation it continues, so a short side request (a chat title, say)
+/// does not discard the long prompt another conversation has already read.
+pub struct SessionPool {
+    pub turn: Arc<Mutex<()>>,
+    pub sessions: Vec<Arc<Mutex<ChatSession>>>,
+    last_used: StdMutex<Vec<Instant>>,
+}
+
+impl SessionPool {
+    pub fn new(sessions: Vec<ChatSession>) -> Self {
+        let now = Instant::now();
+        Self {
+            turn: Arc::new(Mutex::new(())),
+            last_used: StdMutex::new(vec![now; sessions.len()]),
+            sessions: sessions.into_iter().map(|session| Arc::new(Mutex::new(session))).collect(),
+        }
+    }
+
+    pub fn least_recently_used(&self) -> usize {
+        let last_used = self.last_used.lock().expect("last_used lock");
+        last_used.iter().enumerate().min_by_key(|(_, used)| **used).map_or(0, |(index, _)| index)
+    }
+
+    pub fn mark_used(
+        &self,
+        index: usize,
+    ) {
+        self.last_used.lock().expect("last_used lock")[index] = Instant::now();
+    }
+}
