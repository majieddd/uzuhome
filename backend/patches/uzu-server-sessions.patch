+/// Picks the pool's session for a request: the one whose history the request
+/// extends (the longest such history), otherwise the least recently used one,
+/// which prepare_input then resets. Call it while holding the pool's turn.
+async fn pick_session(
+    pool: &SessionPool,
+    messages: &[ChatMessage],
+    prefix_cache: bool,
+) -> Arc<Mutex<ChatSession>> {
+    let mut best: Option<(usize, usize)> = None;
+    if prefix_cache {
+        for (index, session) in pool.sessions.iter().enumerate() {
+            let current = session.lock().await.messages().await;
+            if !current.is_empty()
+                && messages.len() > current.len()
+                && messages_have_prefix(messages, &current)
+                && best.is_none_or(|(_, length)| current.len() > length)
+            {
+                best = Some((index, current.len()));
+            }
+        }
+    }
+    let index = best.map_or_else(|| pool.least_recently_used(), |(index, _)| index);
+    pool.mark_used(index);
+    Arc::clone(&pool.sessions[index])
+}
